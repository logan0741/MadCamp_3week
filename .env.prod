# ===========================================
# MemeForty Production Environment Configuration
# ===========================================

# Backend Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# PostgreSQL Database
# ===========================================
POSTGRES_USER=memeforty
POSTGRES_PASSWORD=secure_password_change_me
POSTGRES_DB=memeforty
DATABASE_URL=postgresql://memeforty:secure_password_change_me@postgres:5432/memeforty

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ===========================================
# SSH Tunnel Configuration (Autossh)
# ===========================================
SSH_HOST=voice-anime-fight.p-e.kr
SSH_USER=root
SSH_PORT=22
SSH_KEY_PATH=~/.ssh/id_rsa
SSH_KNOWN_HOSTS=~/.ssh/known_hosts

# ===========================================
# Static File Serving
# ===========================================
STATIC_BASE_URL=http://nginx-static:8080
NGINX_STATIC_PORT=8080

# ===========================================
# Service URLs (Docker internal)
# ===========================================
NEXT_PUBLIC_API_URL=/api
API_URL=http://backend:8000
AI_PIPELINE_BASE_URL=http://ai-engine:8001
AI_PIPELINE_TIMEOUT_SECONDS=60

# ===========================================
# GPU Configuration
# ===========================================
CUDA_VISIBLE_DEVICES=0

# ===========================================
# AI Pipeline Settings
# ===========================================
VTON_IMAGE_SIZE=768
VTON_NUM_INFERENCE_STEPS=50
VRAM_VTON=16
CELERY_MAX_CONCURRENT=2
LOG_LEVEL=INFO
GEMINI_API_KEY=AIzaSyDrJF0PBocWnL1_T4WZ6d5n2CKAyNpPqZ4
