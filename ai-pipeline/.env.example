# ============================================
# AI Pipeline Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# ============================================
# Server Configuration
# ============================================
# Environment: development, staging, production
ENVIRONMENT=development

# API Server
API_HOST=0.0.0.0
API_PORT=8001
API_WORKERS=4
API_RELOAD=true

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================
# Redis Configuration (Celery Backend)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery Broker URL
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================
# Database Configuration (if needed)
# ============================================
# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/musinsa_ai

# ============================================
# Model Paths & Storage
# ============================================
# Base directory for model weights
MODEL_WEIGHTS_DIR=/root/MadCamp_3week/ai-pipeline/models/weights

# ECON Model
ECON_CHECKPOINT_PATH=${MODEL_WEIGHTS_DIR}/econ/econ_checkpoint.pth
SMPLX_MODEL_PATH=${MODEL_WEIGHTS_DIR}/smplx/SMPLX_NEUTRAL.npz

# BCNet Model
BCNET_CHECKPOINT_PATH=${MODEL_WEIGHTS_DIR}/bcnet/bcnet_checkpoint.pth

# IDM-VTON Model (HuggingFace)
VTON_MODEL_ID=yisol/IDM-VTON
VTON_CACHE_DIR=${MODEL_WEIGHTS_DIR}/vton_cache

# 3DGS (Gaussian Splatting)
GAUSSIANS_CHECKPOINT_PATH=${MODEL_WEIGHTS_DIR}/3dgs/point_cloud.ply

# SHAPY (Body Shape Estimation)
SHAPY_MODEL_PATH=${MODEL_WEIGHTS_DIR}/shapy/SHAPY_A

# SNUG (Garment Simulation)
SNUG_MODEL_PATH=${MODEL_WEIGHTS_DIR}/snug

# ============================================
# File Storage
# ============================================
# Upload directory for user videos/images
UPLOAD_DIR=/root/MadCamp_3week/ai-pipeline/data/uploads

# Output directory for generated avatars/garments
OUTPUT_DIR=/root/MadCamp_3week/ai-pipeline/data/outputs

# CDN Base URL (for production)
CDN_BASE_URL=https://cdn.example.com

# ============================================
# GPU & VRAM Management
# ============================================
# CUDA Device IDs (comma-separated for multi-GPU)
CUDA_VISIBLE_DEVICES=0,1,2,3

# VRAM Allocation (in GB)
VRAM_ECON=40
VRAM_BCNET=20
VRAM_3DGS=20
VRAM_VTON=16

# Maximum concurrent Celery tasks
CELERY_MAX_CONCURRENT=2

# Task timeout (seconds)
CELERY_TASK_TIMEOUT=3600

# ============================================
# AI Model Configuration
# ============================================
# ECON Settings
ECON_IMAGE_RESOLUTION=512
ECON_BATCH_SIZE=1
ECON_NUM_ITERATIONS=100

# BCNet Settings
BCNET_IMAGE_SIZE=512
BCNET_NUM_LAYERS=3

# IDM-VTON Settings
VTON_IMAGE_SIZE=768
VTON_NUM_INFERENCE_STEPS=50
VTON_GUIDANCE_SCALE=7.5

# 3DGS Settings
GAUSSIAN_NUM_POINTS=100000
GAUSSIAN_SH_DEGREE=3

# ============================================
# External Services
# ============================================
# AWS S3 (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=musinsa-ai-assets

# Google Cloud Storage (Optional)
GCS_PROJECT_ID=
GCS_BUCKET_NAME=musinsa-ai-assets

# Sentry (Error Tracking)
SENTRY_DSN=

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/root/MadCamp_3week/ai-pipeline/logs/ai-pipeline.log

# ============================================
# Security
# ============================================
# API Key for inter-service communication
API_SECRET_KEY=your-secret-key-here-change-in-production

# JWT Settings (if needed)
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# ============================================
# Feature Flags
# ============================================
# Enable/disable specific models
ENABLE_ECON=true
ENABLE_BCNET=true
ENABLE_VTON=true
ENABLE_3DGS=true
ENABLE_SHAPY=true
ENABLE_SNUG=true

# Enable debug mode (detailed logging)
DEBUG_MODE=false

# Enable VRAM monitoring
ENABLE_VRAM_MONITORING=true

# ============================================
# Performance Tuning
# ============================================
# PyTorch settings
TORCH_NUM_THREADS=8
OMP_NUM_THREADS=8

# Mixed precision training (fp16)
USE_MIXED_PRECISION=true

# TensorFloat-32 (TF32) for Ampere GPUs
ALLOW_TF32=true
